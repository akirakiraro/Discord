{
  "name": "@radcord/desktop",
  "productName": "SoundRoom",
  "version": "0.1.126",
  "private": true,
  "engines": {
    "node": ">=22.23.0"
  },
  "description": "SoundRoom - voz, vídeo e tela pela rede do Radmin",
  "author": "Akira",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.radcord.desktop",
    "productName": "SoundRoom",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SoundRoom",
      "artifactName": "Radcord-Setup-${version}.${ext}",
      "installerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "resources/loopback",
        "to": "loopback"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "akirakiraro",
      "repo": "Discord",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@livekit/components-react": "^2.9.24",
    "@radcord/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "happy-dom": "^20.8.8",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
