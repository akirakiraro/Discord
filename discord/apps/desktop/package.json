{
  "name": "@radcord/desktop",
  "productName": "Radcord",
  "version": "0.1.36",
  "private": true,
  "description": "Radcord - voz, vídeo e tela pela rede do Radmin",
  "author": "Akira",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win portable",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.radcord.desktop",
    "productName": "Radcord",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@livekit/components-react": "^2.9.24",
    "@radcord/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}
